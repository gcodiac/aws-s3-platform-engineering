# ---------------------------------------------------------------------------
# Copy this file to terraform.tfvars and edit it.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored. This example file is committed so that the
# expected shape of the input is documented, without committing anybody's
# account-specific values.
# ---------------------------------------------------------------------------

# Name prefix and Project tag for everything this configuration creates.
project     = "cloud-launchpad"
environment = "course"

# Region for the S3 bucket. Pick one close to you.
# CloudFront is global, and ACM certificates for CloudFront are always
# requested in us-east-1 regardless of what you set here.
aws_region = "eu-west-1"

# Leave empty to derive a globally unique name:
#   <project>-<environment>-<account id>
# Set it explicitly if you need a specific bucket name.
# bucket_name = ""

# Extra tags merged with Project / Environment / ManagedBy.
# tags = {
#   Owner      = "platform-team"
#   CostCentre = "training"
# }

# --- Origin bucket ---------------------------------------------------------

# Keep previous object versions so a bad deploy can be rolled back.
enable_versioning                = true
noncurrent_version_retention_days = 30

# Set to true ONLY for disposable lab environments. It lets `terraform
# destroy` delete a bucket that still contains objects.
force_destroy_bucket = true

# --- CloudFront ------------------------------------------------------------

default_root_object = "index.html"

# PriceClass_100  North America and Europe (cheapest)
# PriceClass_200  adds Asia, the Middle East and Africa
# PriceClass_All  every edge location
price_class = "PriceClass_100"

# --- Custom domain and TLS -------------------------------------------------
#
# Leave domain_name empty to use the free *.cloudfront.net domain.
#
# With a domain, there are two paths:
#
#   Route 53 in this account
#     domain_name          = "launchpad.example.com"
#     route53_zone_id      = "Z0123456789ABCDEFGHIJ"
#     attach_custom_domain = true
#   One apply does everything.
#
#   DNS elsewhere (Cloudflare, the registrar, a corporate zone)
#     1. Set domain_name only, and apply.
#     2. Read `terraform output acm_validation_records` and create those
#        records at your DNS provider. Leave them there forever — ACM
#        re-checks them at renewal.
#     3. Wait for `terraform output acm_certificate_status` to read ISSUED.
#     4. Set attach_custom_domain = true and apply again.
#     5. Point your domain at `terraform output cloudfront_domain_name`
#        with a CNAME (or an ALIAS/ANAME record at the zone apex).
#
# domain_name               = "launchpad.example.com"
# subject_alternative_names = ["www.launchpad.example.com"]
# route53_zone_id           = ""
# attach_custom_domain      = false
# minimum_protocol_version  = "TLSv1.2_2021"
